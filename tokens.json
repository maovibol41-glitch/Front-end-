{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Ledger-grade calm for Cambodian SME commerce — ink-dark surfaces, mulberry accent, and gold reserved as a Khmer-heritage semantic signal for money.",
  "color": {
    "$type": "color",
    "primary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.106,
          0.106,
          0.122
        ],
        "hex": "#1b1b1f"
      }
    },
    "secondary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.424,
          0.451,
          0.502
        ],
        "hex": "#6c7380"
      }
    },
    "secondary-muted": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.396,
          0.42,
          0.463
        ],
        "hex": "#656b76"
      }
    },
    "tertiary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.494,
          0.078,
          1
        ],
        "hex": "#7e14ff"
      }
    },
    "neutral": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.98,
          0.976,
          0.969
        ],
        "hex": "#faf9f7"
      }
    },
    "on-primary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          1,
          1
        ],
        "hex": "#ffffff"
      }
    },
    "on-tertiary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          1,
          1
        ],
        "hex": "#ffffff"
      }
    },
    "surface": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          1,
          1
        ],
        "hex": "#ffffff"
      }
    },
    "surface-muted": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.949,
          0.945,
          0.933
        ],
        "hex": "#f2f1ee"
      }
    },
    "border": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.894,
          0.882,
          0.863
        ],
        "hex": "#e4e1dc"
      }
    },
    "success": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.118,
          0.478,
          0.275
        ],
        "hex": "#1e7a46"
      }
    },
    "caution-text": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.541,
          0.416,
          0.071
        ],
        "hex": "#8a6a12"
      }
    },
    "caution-bg": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.961,
          0.773,
          0.259
        ],
        "hex": "#f5c542"
      }
    },
    "danger": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.702,
          0.149,
          0.118
        ],
        "hex": "#b3261e"
      }
    },
    "on-dark-muted": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.655,
          0.675,
          0.71
        ],
        "hex": "#a7acb5"
      }
    }
  },
  "spacing": {
    "$type": "dimension",
    "xs": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "sm": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "xl": {
      "$value": {
        "value": 32,
        "unit": "px"
      }
    },
    "xxl": {
      "$value": {
        "value": 48,
        "unit": "px"
      }
    }
  },
  "rounded": {
    "$type": "dimension",
    "sm": {
      "$value": {
        "value": 6,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "xl": {
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "full": {
      "$value": {
        "value": 9999,
        "unit": "px"
      }
    }
  },
  "typography": {
    "display": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Inter",
        "fontSize": {
          "value": 2.25,
          "unit": "rem"
        },
        "fontWeight": 700,
        "letterSpacing": {
          "value": -0.02,
          "unit": "em"
        }
      }
    },
    "h1": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Inter",
        "fontSize": {
          "value": 1.75,
          "unit": "rem"
        },
        "fontWeight": 700,
        "letterSpacing": {
          "value": -0.015,
          "unit": "em"
        }
      }
    },
    "h2": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Inter",
        "fontSize": {
          "value": 1.25,
          "unit": "rem"
        },
        "fontWeight": 600
      }
    },
    "body-md": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Inter",
        "fontSize": {
          "value": 1,
          "unit": "rem"
        }
      }
    },
    "body-sm": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Inter",
        "fontSize": {
          "value": 0.875,
          "unit": "rem"
        }
      }
    },
    "label-caps": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Inter",
        "fontSize": {
          "value": 0.75,
          "unit": "rem"
        },
        "fontWeight": 600,
        "letterSpacing": {
          "value": 0.06,
          "unit": "em"
        }
      }
    },
    "numeral-mono": {
      "$type": "typography",
      "$value": {
        "fontFamily": "JetBrains Mono",
        "fontSize": {
          "value": 1,
          "unit": "rem"
        }
      }
    },
    "currency-khr": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Inter",
        "fontSize": {
          "value": 0.875,
          "unit": "rem"
        },
        "fontWeight": 700
      }
    }
  }
}
